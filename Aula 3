#Exemplo 3:
x <- c(2, 8, 6, 1, 10, 4)

contador <- 0

for(valor in x){
  if(valor > 5){
    contador <- contador + 1
  }
}
print(contador)

#Utilizando o While

#Exemplo 1: 
contador <- 1  # 1. Variável inicial
while (contador <= 5) {  # 2. Condição testada a cada rodada
  print(paste("O contador está em:", contador))
  
  contador <- contador + 1  # 3. Atualização (Indispensável)
}
print("O loop terminou!")

#Exemplo 2:
saldo <- 1000
meta <- 2000
meses <- 0

while (saldo < meta) {
  
  saldo <- saldo + (saldo * 0.05)
  
  meses <- meses + 1
}

print(paste("Foram necessários", meses, "meses para dobrar o dinheiro."))
print(paste("Saldo final exato: R$", round(saldo, 2)))
